{
  "manifest_version": 3,
  "name": "NTU CCDS Master Project Extractor",
  "description": "Extract and filter NTU CCDS Master project information to markdown format",
  "background": { "service_worker": "background.bundle.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-34.png"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wis.ntu.edu.sg/pls/webexe/mas_sce_student.Filter_Options"
      ],
      "js": ["contentScript.bundle.js"],
      "css": ["content.styles.css"]
    }
  ],
  "permissions": ["clipboardWrite", "storage", "tabs", "scripting"],
  "host_permissions": ["https://wis.ntu.edu.sg/*"],
  "web_accessible_resources": [
    {
      "resources": ["content.styles.css", "icon-128.png", "icon-34.png"],
      "matches": ["https://wis.ntu.edu.sg/*"]
    }
  ]
}
